generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                 String   @id @default(cuid())
  name               String
  category           String
  price              Int
  image              String
  images             String?  @default("[]")
  videoUrl           String?
  description        String
  inStock            Boolean  @default(true)
  stockQuantity      Int?     @map("stock_quantity")
  lowStockThreshold  Int      @default(3) @map("low_stock_threshold")
  badge              String?
  rating             Float    @default(4.8)
  reviews            Int      @default(0)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  orderItems         OrderItem[]

  @@map("products")
}

model Order {
  id           String      @id @default(cuid())
  customerName String      @map("customer_name")
  phone        String
  email        String      @default("")
  total        Int
  status       String      @default("pending")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  items        OrderItem[]
  notificationRecipients OrderNotificationRecipient[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  name      String
  price     Int
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model AdminSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_settings")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  image     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model PushSubscription {
  id             String    @id @default(cuid())
  /// Firebase Installation ID (FID) or web FCM token used as stable device key
  installationId String    @unique @map("installation_id")
  /// Optional FCM registration token (web); often same as installationId for web
  token          String?   @unique
  userAgent      String?   @map("user_agent") @db.Text
  platform       String?
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  lastSentAt     DateTime? @map("last_sent_at")
  failCount      Int       @default(0) @map("fail_count")
  orderLinks     OrderNotificationRecipient[]

  @@index([enabled])
  @@map("push_subscriptions")
}

/// Join: one order ↔ many devices; one device ↔ many orders
model OrderNotificationRecipient {
  id                 String           @id @default(cuid())
  orderId            String           @map("order_id")
  pushSubscriptionId String           @map("push_subscription_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  order              Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pushSubscription   PushSubscription @relation(fields: [pushSubscriptionId], references: [id], onDelete: Cascade)

  @@unique([orderId, pushSubscriptionId])
  @@index([orderId])
  @@index([pushSubscriptionId])
  @@map("order_notification_recipients")
}

model NotificationLog {
  id          String   @id @default(cuid())
  title       String
  body        String   @db.Text
  audience    String   @default("all")
  sentCount   Int      @default(0) @map("sent_count")
  failedCount Int      @default(0) @map("failed_count")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("notification_logs")
}
