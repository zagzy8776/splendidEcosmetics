# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# URL of the deployed backend API (no trailing slash)
VITE_API_URL=https://your-backend.onrender.com

# ─── Backend (server.js) ──────────────────────────────────────────────────────
# PostgreSQL connection string (e.g. from Neon, Supabase, Railway)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Admin password — set a strong unique value, never commit the real value
ADMIN_PASSWORD=change-me-to-something-strong

# Port the backend listens on (Render sets this automatically)
PORT=4000

# Allowed frontend origin for CORS (your Vercel deployment URL)
FRONTEND_URL=https://your-frontend.vercel.app

# ─── Cloudinary Image Upload ──────────────────────────────────────────────────
# Required for admin product image uploads. Get these from your Cloudinary Dashboard.
CLOUDINARY_CLOUD_NAME=djup7klv2
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ─── Resend Transactional Email ───────────────────────────────────────────────
# Resend API secret key — obtain from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Sender address — must use your verified domain
# e.g. Brand Name <noreply@yourdomain.com>
RESEND_FROM=Splendid Empire Cosmetics <orders@splendidcosmetics.com.ng>

# Address where customer replies will be routed (your contact Gmail)
RESEND_REPLY_TO=your-contact@gmail.com
# ─── Firebase (Frontend — public client config) ───────────────────────────────
# From Firebase Console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=splendid-e-cosmetics
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Web Push certificates (Cloud Messaging → Web Push certificates)
VITE_FIREBASE_VAPID_KEY=

# ─── Firebase Admin (Backend ONLY — never use VITE_ prefix) ───────────────────
# From Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=splendid-e-cosmetics
FIREBASE_CLIENT_EMAIL=
# Paste private_key value; keep \n escapes or real newlines both work
FIREBASE_PRIVATE_KEY=
